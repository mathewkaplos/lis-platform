    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^9.3.0",
    "@lis/db": "workspace:*",
    "@lis/domain": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6",
    "@nestjs/swagger": "^11.4.6",
    "@sentry/nestjs": "^10.68.0",
    "@sentry/profiling-node": "^10.68.0",
    "bwip-js": "^4.11.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.9.6",
    "nestjs-zod": "^5.5.0",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/fhir": "^0.0.44",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
