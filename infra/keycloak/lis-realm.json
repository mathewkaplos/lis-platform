{
  "realm": "lis",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "technologist",
        "description": "Bench role: may enter results, may not verify them (TASK-032)"
      },
      {
        "name": "verifier",
        "description": "May verify results entered by a technologist (TASK-032)"
      },
      {
        "name": "qa",
        "description": "Quality/lab-manager role: may resolve QC rule violations, may not enter or verify patient results (TASK-070)"
      },
      {
        "name": "gateway-ingest",
        "description": "Machine role for the edge integration gateway's service account (FEAT-026, ADR-0026) -- scoped to the internal ingestion endpoint only, never granted to a human user"
      },
      {
        "name": "interop-ingest",
        "description": "Machine role for the HL7 v2 ACL's service account (FEAT-036, ADR-0035) -- scoped to apps/interop's own calls into apps/api, never granted to a human user"
      },
      {
        "name": "clinician",
        "description": "External clinician role (FEAT-040, KB-10): may access only patients with an established care_relationship row, never the whole tenant -- unlike technologist/verifier/qa"
      },
      {
        "name": "patient",
        "description": "External patient-portal role (FEAT-039, KB-32): may view only their own verified results/trends via patient_portal_account, gated by result_release_policy"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "openid",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "basic",
      "description": "OpenID Connect scope for the core sub/auth_time claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "foo",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "lis-web",
      "name": "LIS Web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://lis-staging.taila0fbf9.ts.net/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://lis-staging.taila0fbf9.ts.net"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "tenant",
        "openid",
        "basic",
        "roles"
      ]
    },
    {
      "clientId": "lis-gateway",
      "name": "LIS Edge Integration Gateway",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-lis-gateway-secret",
      "defaultClientScopes": [
        "tenant",
        "openid",
        "basic",
        "roles"
      ]
    },
    {
      "clientId": "lis-interop",
      "name": "LIS HL7 v2 Interop ACL",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-lis-interop-secret",
      "defaultClientScopes": [
        "tenant",
        "openid",
        "basic",
        "roles"
      ]
    }
  ],
