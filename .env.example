DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lis
LIS_APP_DB_PASSWORD=lis_app_dev_password
APP_DATABASE_URL=postgresql://lis_app:lis_app_dev_password@localhost:5432/lis
# TASK-066 (ADR-0017): lis_scheduler, NOBYPASSRLS, used only by the critical-
# notification escalation job's enumeration phase (SELECT tenant_id where
# status='pending') -- never for the actual mutating escalation write, which
# uses APP_DATABASE_URL/lis_app like every other write in this repo.
SCHEDULER_DB_PASSWORD=lis_scheduler_dev_password
SCHEDULER_DATABASE_URL=postgresql://lis_scheduler:lis_scheduler_dev_password@localhost:5432/lis
# Minutes a critical_notification stays 'pending' before the escalation job
# marks it 'escalated' (ADR-0017 revision, approved 30 min).
CRITICAL_NOTIFICATION_ESCALATION_MINUTES=30
VALKEY_URL=redis://localhost:6379
NODE_ENV=development
# Signs apps/web's own session + PKCE-state cookies (TASK-031). Dev-only
# value, never reused for staging/production -- see deploy-staging.yml's
# SESSION_SECRET GitHub secret for the real one.
SESSION_SECRET=dev-only-session-secret-change-in-production
# TASK-040: where apps/web's server-side calls (lib/api-client.ts) reach
# apps/api. Local dev only -- both apps run directly on the host, so
# localhost works; staging uses the compose-internal hostname instead
# (infra/docker-compose.staging.yml's own API_BASE_URL: http://api:4000).
API_BASE_URL=http://localhost:4000
# FEAT-059 (ADR-0051): server-held HMAC-SHA256 key for AP case sign-out
# signatures (packages/db/src/case-report-signature.ts). Dev-only value,
# never reused for staging/production -- see deploy-staging.yml's
# SIGNING_SECRET GitHub secret for the real one, same convention as
# SESSION_SECRET above.
SIGNING_SECRET=dev-only-signing-secret-change-in-production-32b
# FEAT-061 (ADR-0052): self-hosted MinIO (docker-compose.yml's own minio
# service), S3-API-compatible. Local dev only -- see issue #564 for why
# staging deployment is deferred (no memory headroom on the current
# droplet). Credentials match docker-compose.yml's MINIO_ROOT_USER/
# MINIO_ROOT_PASSWORD.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=lis-images
